# Copy to .env and fill in. Never commit the real .env.
PORT=9999
HOST=127.0.0.1
STATE_PATH=./data/state.json
# First port for app-preview allocation (9111–9200, one port per running project).
PREVIEW_BASE_PORT=9111

# Telegram bot (required for approvals + notifications). Create via @BotFather.
TELEGRAM_BOT_TOKEN=
# admin chat ids (comma-separated allowed: 111,222). The bot only answers these.
TELEGRAM_ADMIN_IDS=
TELEGRAM_POLL_SECONDS=5

# Extra MCPs (optional): JSON map id → {command:[...]|url, desc}.
# Example: ALTHEA_MCP_SERVERS={"kbbi":{"command":["node","/opt/mcp-kbbi.js"],"desc":"KBBI"}}
# Brain: CLI path/command + model/effort (empty = CLI default).
# Linux (`muse exec`, model/effort flags active):
BRAIN_BIN=muse
BRAIN_SUBCOMMAND=exec
# Windows PowerShell (spawn needs .exe; empty SUBCOMMAND = `-p` mode,
# needs a Claude subscription — skip this if you only have a Meta/Muse subscription):
# BRAIN_BIN=C:/Users/NAME/.local/bin/claude.exe
# BRAIN_SUBCOMMAND=
BRAIN_MODEL=
# none|minimal|low|medium|high|xhigh|max|ultra (CLI default: high; exec mode only)
BRAIN_EFFORT=
# Subscription reset ±5 hours. Auto-resume waits this long after a limit hit.
CLAUDE_RESET_HOURS=5
# Timeout for one Muse execution (seconds). MVP from scratch can take >10 minutes.
# Can be overridden without restart from the dashboard (System → execution_limit).
CLAUDE_TIMEOUT_SECONDS=1800
# Timeout → auto-requeue up to N attempts, then fail.
TASK_MAX_ATTEMPTS=3
# Mode without real Muse execution (1 = simulation, for quota-free laptop tests).
CLAUDE_DRY_RUN=0

# Main loop every N seconds.
LOOP_SECONDS=15
# Automatic report every N hours to Telegram (0 = off).
REPORT_EVERY_HOURS=6

# Approval escalation rules (minutes): web → telegram → decide alone.
APPROVAL_WEB_MINUTES=3
APPROVAL_TELEGRAM_MINUTES=3
# 1 = with no response on either channel Althea decides alone (destructive=reject).
# 0 = wait for the admin forever.
APPROVAL_AUTODECIDE=1

# Dashboard password. REQUIRED on deploy (without it, only localhost is served).
ADMIN_PASSWORD=
# Login session length (days).
SESSION_DAYS=7

# Workspace: home of all projects.
WORKSPACE_DIR=./workspace
# Upload zip size limit (MB).
PROJECT_MAX_MB=50
# Git command + clone timeout (seconds).
GIT_BIN=git
GIT_TIMEOUT_SECONDS=180

# LangGraph agent (plan→implement→review). 0 = legacy single-shot mode.
GRAPH_ENABLED=1
# Max implement-review rounds per task.
GRAPH_MAX_ROUNDS=3
# Token saving: plan slice = plan without an LLM round; review gate = system diff check.
# Per-pipeline-phase policy (features = slice+gate, full LLM review only at release) overrides this.
#GRAPH_PLAN_MODE=llm
#GRAPH_REVIEW_MODE=llm
# Deterministic verifier (FR-3.10): project npm scripts run by the system
# after implementation (0 LLM tokens). Only scripts present in package.json.
VERIFY_ENABLED=1
#VERIFY_SCRIPTS=check,test,build
#VERIFY_TIMEOUT_SECONDS=180
# Project pipeline PRD→MVP→features→release: max feature-phase rounds.
PIPELINE_FEATURE_ROUNDS=3

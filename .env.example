# Salin ke .env lalu isi. Jangan commit .env asli.
PORT=9999
HOST=127.0.0.1
STATE_PATH=./data/state.json
# Port awal alokasi preview aplikasi (9111–9200, satu port per project jalan).
PREVIEW_BASE_PORT=9111

# Telegram bot (wajib untuk izin + notif). Buat via @BotFather.
TELEGRAM_BOT_TOKEN=
# chat id admin (boleh koma-pisah: 111,222). Bot hanya merespons id ini.
TELEGRAM_ADMIN_IDS=
TELEGRAM_POLL_SECONDS=5

# MCP tambahan (opsional): JSON map id → {command:[...]|url, desc}.
# Contoh: ALTHEA_MCP_SERVERS={"kbbi":{"command":["node","/opt/mcp-kbbi.js"],"desc":"KBBI"}}
# Otak: path/ perintah CLI + model/effort (kosong = default CLI).
# Linux (`muse exec`, flags model/effort aktif):
BRAIN_BIN=muse
BRAIN_SUBCOMMAND=exec
# Windows PowerShell (spawn butuh .exe; SUBCOMMAND kosong = mode `-p`,
# butuh langganan Claude — lewati ini bila hanya langganan Meta/Muse):
# BRAIN_BIN=C:/Users/NAMA/.local/bin/claude.exe
# BRAIN_SUBCOMMAND=
BRAIN_MODEL=
# none|minimal|low|medium|high|xhigh|max|ultra (default CLI: high; hanya mode exec)
BRAIN_EFFORT=
# Reset langganan ±5 jam. Auto-resume menunggu selama ini setelah limit.
CLAUDE_RESET_HOURS=5
# Timeout satu eksekusi Muse (detik). MVP dari nol bisa >10 menit.
CLAUDE_TIMEOUT_SECONDS=1800
# Timeout → antre-ulang otomatis sampai N percobaan lalu gagal.
TASK_MAX_ATTEMPTS=3
# Mode tanpa eksekusi Muse asli (1 = simulasi, untuk tes laptop tanpa kuota).
CLAUDE_DRY_RUN=0

# Loop utama tiap N detik.
LOOP_SECONDS=15
# Laporan otomatis tiap N jam ke Telegram (0 = mati).
REPORT_EVERY_HOURS=6

# Aturan eskalasi izin (menit): web → telegram → putuskan sendiri.
APPROVAL_WEB_MINUTES=3
APPROVAL_TELEGRAM_MINUTES=3
# 1 = tanpa respons di kedua kanal Althea memutuskan sendiri (destruktif=tolak).
# 0 = tunggu admin selamanya.
APPROVAL_AUTODECIDE=1

# Password dashboard. WAJIB diisi saat deploy (tanpa ini hanya localhost).
ADMIN_PASSWORD=
# Lama sesi login (hari).
SESSION_DAYS=7

# Workspace: rumah semua project.
WORKSPACE_DIR=./workspace
# Batas ukuran upload zip (MB).
PROJECT_MAX_MB=50
# Perintah git + timeout clone (detik).
GIT_BIN=git
GIT_TIMEOUT_SECONDS=180

# Agen LangGraph (plan→implement→review). 0 = mode single-shot lama.
GRAPH_ENABLED=1
# Maks ronde implement-review per tugas.
GRAPH_MAX_ROUNDS=3
# Hemat token: plan slice = rencana tanpa ronde LLM; review gate = cek diff sistem.
# Kebijakan per-fase pipeline (fitur = slice+gate, review LLM hanya di rilis) menimpa ini.
#GRAPH_PLAN_MODE=llm
#GRAPH_REVIEW_MODE=llm
# Verifier deterministik (FR-3.10): skrip npm project yang dijalankan sistem
# setelah implementasi (0 token LLM). Hanya skrip yang ADA di package.json.
VERIFY_ENABLED=1
#VERIFY_SCRIPTS=check,test,build
#VERIFY_TIMEOUT_SECONDS=180
# Pipeline project PRD→MVP→fitur→rilis: maks ronde fase fitur.
PIPELINE_FEATURE_ROUNDS=3

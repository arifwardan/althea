{
  "name": "althea",
  "version": "0.1.0",
  "description": "Althea — runtime otonom laptop-first (nanti VPS+domain), otak Muse CLI, izin via Telegram.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite",
    "start": "node dist/index.js",
    "build": "npm run build:web && tsc -p tsconfig.json",
    "build:web": "vite build",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy -u ALL_PROXY -u all_proxy node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^20.11.0",
    "svelte": "^5.57.1",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.16",
    "@tailwindcss/vite": "^4.3.3",
    "adm-zip": "^0.6.1",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

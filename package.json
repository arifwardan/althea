{
  "name": "althea",
  "version": "0.1.0",
  "description": "Althea — runtime otonom laptop-first (nanti VPS+domain), otak Muse CLI, izin via Telegram.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite",
    "start": "node dist/index.js",
    "build": "npm run build:web && tsc -p tsconfig.json",
    "build:web": "vite build",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/node": "^20.11.0",
    "svelte": "^5.57.1",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.16",
    "adm-zip": "^0.6.1"
  }
}
